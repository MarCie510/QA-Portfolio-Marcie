        {
          "name": "Booking - CreateBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "const schema = {",
                  "    \"type\": \"object\",",
                  "    \"properties\": {",
                  "        \"bookingid\": { \"type\": \"number\" },",
                  "        \"booking\": {",
                  "            \"type\": \"object\",",
                  "            \"properties\": {",
                  "                \"firstname\": { \"type\": \"string\" },",
                  "                \"lastname\": { \"type\": \"string\" },",
                  "                \"totalprice\": { \"type\": \"number\" },",
                  "                \"depositpaid\": { \"type\": \"boolean\" },",
                  "                \"bookingdates\": {",
                  "                    \"type\": \"object\",",
                  "                    \"properties\": {",
                  "                        \"checkin\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },",
                  "                        \"checkout\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" }",
                  "                    },",
                  "                    \"required\": [\"checkin\", \"checkout\"]",
                  "                },",
                  "                \"additionalneeds\": { \"type\": \"string\" }",
                  "            },",
                  "            \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"]",
                  "        }",
                  "    },",
                  "    \"required\": [\"bookingid\", \"booking\"]",
                  "};",
                  "",
                  "pm.test(\"Schema is valid\", () => { pm.response.to.have.jsonSchema(schema); });",
                  "pm.test(\"Status is 200 OK\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"Response time < 1000ms\", () => { pm.expect(pm.response.responseTime).to.be.below(1000); }); ",
                  "",
                  "if (response.bookingid) {",
                  "    pm.environment.set(\"bookingId\", response.bookingid);",
                  "    pm.environment.set(\"firstName\", response.booking.firstname);",
                  "    pm.environment.set(\"lastName\", response.booking.lastname);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\" : \"{{$randomFirstName}}\",\n    \"lastname\" : \"{{$randomLastName}}\",\n    \"totalprice\" : {{$randomInt}},\n    \"depositpaid\" : {{$randomBoolean}},\n    \"bookingdates\" : {\n        \"checkin\" : \"2026-01-01\",\n        \"checkout\" : \"2026-01-10\"\n    },\n    \"additionalneeds\" : \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Booking - GetBookingById",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "// 1. Status & Performance (Value Tests)",
                  "pm.test(\"Status code is 200 OK\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"Response time is < 1000ms\", () => { pm.expect(pm.response.responseTime).to.be.below(1000); });",
                  "",
                  "// 2. Data Consistency (Positive Tests)",
                  "pm.test(\"Verify Firstname matches dynamically created booking\", () => { ",
                  "    pm.expect(response.firstname).to.eql(pm.environment.get(\"firstName\")); ",
                  "});",
                  "pm.test(\"Verify Lastname matches dynamically created booking\", () => { ",
                  "    pm.expect(response.lastname).to.eql(pm.environment.get(\"lastName\")); ",
                  "});",
                  "pm.test(\"Verify Deposit Paid is boolean\", () => { ",
                  "    pm.expect(response.depositpaid).to.be.a('boolean'); ",
                  "});",
                  "",
                  "// 3. Date Format Validation (Regex)",
                  "pm.test(\"Checkin date format is YYYY-MM-DD\", () => { ",
                  "    pm.expect(response.bookingdates.checkin).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); ",
                  "});",
                  "pm.test(\"Price is a number\", () => { ",
                  "    pm.expect(response.totalprice).to.be.a('number'); ",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Booking - UpdateBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Parse response safely",
                  "const contentType = pm.response.headers.get(\"Content-Type\");",
                  "const isJson = contentType && contentType.includes(\"application/json\");",
                  "",
                  "// 2. Status Code Test",
                  "pm.test(\"Status code is 200 OK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (isJson) {",
                  "    const response = pm.response.json();",
                  "",
                  "    // 3. Positive Tests (In English)",
                  "    pm.test(\"Response time is below 1000ms\", () => {",
                  "        pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "    });",
                  "",
                  "    pm.test(\"Total price matches the update (500)\", () => {",
                  "        pm.expect(response.totalprice).to.eql(500);",
                  "    });",
                  "",
                  "    pm.test(\"Additional needs match 'Full Update Test'\", () => {",
                  "        pm.expect(response.additionalneeds).to.eql(\"Full Update Test\");",
                  "    });",
                  "",
                  "    // 4. Persistence Check (Value Test)",
                  "    pm.test(\"Firstname is not empty\", () => {",
                  "        pm.expect(response.firstname).to.not.be.empty;",
                  "    });",
                  "",
                  "    // 5. Automation",
                  "    pm.environment.set(\"firstNameUpdate\", response.firstname);",
                  "",
                  "} else {",
                  "    console.error(\"Non-JSON response received. Status: \" + pm.response.code);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{$randomFirstName}}\",\n    \"lastname\": \"{{$randomLastName}}\",\n    \"totalprice\": 500,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-02-01\",\n        \"checkout\": \"2026-02-05\"\n    },\n    \"additionalneeds\": \"Full Update Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Booking - PartialUpdateBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Response validation",
                  "const response = pm.response.json();",
                  "",
                  "// 2. Status & Performance Tests",
                  "pm.test(\"Status code is 200 OK\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"Response time is < 800ms\", () => { pm.expect(pm.response.responseTime).to.be.below(800); });",
                  "",
                  "// 3. Positive Tests (Verify partial update)",
                  "pm.test(\"Firstname was successfully patched\", () => { ",
                  "    pm.expect(response.firstname).to.include(\"Master-\"); ",
                  "});",
                  "",
                  "pm.test(\"Lastname was successfully patched\", () => { ",
                  "    pm.expect(response.lastname).to.eql(\"QA-Specialist\"); ",
                  "});",
                  "",
                  "// 4. Regression Test (Verify unchanged fields still have previous values)",
                  "pm.test(\"Price remains unchanged from previous PUT (500)\", () => { ",
                  "    pm.expect(response.totalprice).to.eql(500); ",
                  "});",
                  "",
                  "// 5. Value Test (Header check)",
                  "pm.test(\"Response format is JSON\", () => {",
                  "    pm.response.to.be.withBody;",
                  "    pm.response.to.be.json;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"Master-{{firstNameUpdate}}\",\n    \"lastname\": \"QA-Specialist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Booking - GetBookingIdsByFilter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "const searchFirstName = \"Master-\" + pm.environment.get(\"firstNameUpdate\");",
                  "const searchLastName = \"QA-Specialist\";",
                  "",
                  "// 1. Technical Validations",
                  "pm.test(\"Status code is 200 OK\", () => { pm.response.to.have.status(200); });",
                  "",
                  "// 2. Comprehensive Logging (Open Postman Console to see this)",
                  "console.log(\"Searching for Firstname: \" + searchFirstName);",
                  "console.log(\"Searching for Lastname: \" + searchLastName);",
                  "console.log(\"API Response: \", response);",
                  "",
                  "// 3. Conditional Tests (To avoid script crash)",
                  "if (response.length > 0) {",
                  "    pm.test(\"Filter returns valid results\", () => { ",
                  "        pm.expect(response).to.be.an('array'); ",
                  "    });",
                  "",
                  "    pm.test(\"Current bookingId is in the results\", () => {",
                  "        const currentId = parseInt(pm.environment.get(\"bookingId\"));",
                  "        const idExists = response.some(obj => obj.bookingid === currentId);",
                  "        pm.expect(idExists).to.be.true;",
                  "    });",
                  "} else {",
                  "    // If empty, we fail with a descriptive message for the portfolio",
                  "    pm.test(\"Search Results Found\", () => {",
                  "        pm.expect(response.length, \"The API returned 0 results for the filter. Check if the record was deleted or if the name matches exactly.\").to.be.above(0);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname=Master-{{firstNameUpdate}}&lastname=QA-Specialist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "Master-{{firstNameUpdate}}"
                },
                {
                  "key": "lastname",
                  "value": "QA-Specialist"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Booking - DeleteBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", () => { pm.response.to.have.status(201); });",
                  "pm.test(\"Response time < 1000ms\", () => { pm.expect(pm.response.responseTime).to.be.below(1000); });",
                  "pm.test(\"Body confirms deletion\", () => { pm.expect(pm.response.text()).to.include(\"Created\"); });",
                  "",
                  "pm.environment.unset(\"bookingId\");",
                  "pm.environment.unset(\"firstName\");",
                  "pm.environment.unset(\"lastName\");",
                  "pm.environment.unset(\"firstNameUpdate\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        }
      ],
      "description": "Happy Path workflow validating the full lifecycle (CRUD) of a booking."
    },
    {
      "name": "Negative Tests",
      "item": [
        {
          "name": "Security - Delete with Bad Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Status Code Validation",
                  "// We expect 403 because we provided an invalid auth token",
                  "pm.test(\"Status code is 403 Forbidden\", () => {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "// 2. Error Message Validation",
                  "// The API should explicitly state that access is forbidden",
                  "pm.test(\"Response body contains 'Forbidden'\", () => {",
                  "    pm.expect(pm.response.text()).to.include(\"Forbidden\");",
                  "});",
                  "",
                  "// 3. Performance Check",
                  "// Security rejections should be handled quickly by the server",
                  "pm.test(\"Response time is < 500ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token=BAD_TOKEN_123",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "1"
              ]
            }
          },
          "response": []
        },
        {
