<?xml version="1.0" encoding="UTF-8" ?>
<nodes>
  <suites>
    <node>
      <id>50</id>
      <title>Navigation &amp; UI</title>
      <description>Functional testing suite for navigation elements, hamburger menu, footer links and overall UI consistency.</description>
      <preconditions></preconditions>
      <suites></suites>
      <cases>

        <node>
          <id>501</id>
          <title>Hamburger menu opens and displays all options</title>
          <description>Validate that the hamburger menu opens correctly and shows all expected navigation options.</description>
          <preconditions>User is logged in as standard_user on the inventory page.</preconditions>
          <postconditions>Menu is visible with all options.</postconditions>
          <priority>medium</priority>
          <severity>major</severity>
          <type>functional</type>
          <behavior>positive</behavior>
          <automation>is-not-automated</automation>
          <status>actual</status>
          <is_flaky>no</is_flaky>
          <layer>e2e</layer>
          <milestone></milestone>
          <custom_fields></custom_fields>
          <steps_type>classic</steps_type>
          <steps>
            <node>
              <position>1</position>
              <action>Click the hamburger menu icon (top left)</action>
              <expected_result>Side menu opens displaying: All Items, About, Logout, Reset App State.</expected_result>
              <data></data>
              <steps></steps>
            </node>
            <node>
              <position>2</position>
              <action>Click the X button to close the menu</action>
              <expected_result>Menu closes. Inventory page remains visible.</expected_result>
              <data></data>
              <steps></steps>
            </node>
          </steps>
          <tags></tags>
          <params></params>
          <is_muted>no</is_muted>
        </node>

        <node>
          <id>502</id>
          <title>All Items link returns to inventory from any page</title>
          <description>Validate that the All Items menu option navigates back to the inventory page.</description>
          <preconditions>User is logged in. User is on the cart page.</preconditions>
          <postconditions>User is redirected to the inventory page.</postconditions>
          <priority>medium</priority>
          <severity>minor</severity>
          <type>functional</type>
          <behavior>positive</behavior>
          <automation>is-not-automated</automation>
          <status>actual</status>
          <is_flaky>no</is_flaky>
          <layer>e2e</layer>
          <milestone></milestone>
          <custom_fields></custom_fields>
          <steps_type>classic</steps_type>
          <steps>
            <node>
              <position>1</position>
              <action>From the cart page, open the hamburger menu and click "All Items"</action>
              <expected_result>User is redirected to /inventory.html. All products are displayed.</expected_result>
              <data></data>
              <steps></steps>
            </node>
          </steps>
          <tags></tags>
          <params></params>
          <is_muted>no</is_muted>
        </node>

        <node>
          <id>503</id>
          <title>Reset App State clears the cart</title>
          <description>Validate that Reset App State removes all items from the cart and resets button states.</description>
          <preconditions>User is logged in. Three products are in the cart.</preconditions>
          <postconditions>Cart is empty. All Add to cart buttons reset.</postconditions>
          <priority>medium</priority>
          <severity>major</severity>
          <type>functional</type>
          <behavior>positive</behavior>
          <automation>is-not-automated</automation>
          <status>actual</status>
          <is_flaky>no</is_flaky>
          <layer>e2e</layer>
          <milestone></milestone>
          <custom_fields></custom_fields>
          <steps_type>classic</steps_type>
          <steps>
            <node>
              <position>1</position>
              <action>Open hamburger menu and click "Reset App State"</action>
              <expected_result>Cart badge disappears. All product buttons reset to "Add to cart".</expected_result>
              <data></data>
              <steps></steps>
            </node>
            <node>
              <position>2</position>
              <action>Navigate to cart page and verify it is empty</action>
              <expected_result>Cart page shows no items.</expected_result>
              <data></data>
              <steps></steps>
            </node>
          </steps>
          <tags></tags>
          <params></params>
          <is_muted>no</is_muted>
        </node>

